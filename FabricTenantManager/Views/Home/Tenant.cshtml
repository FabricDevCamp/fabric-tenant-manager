@model FabricTenantManager.Models.FabricTenant

<h2>
  <span><a class="btn btn-sm h2-backarrow" asp-action="Index"><i class="fa fa-backward"></i></a></span>
  <span>Tenant Details</span>
</h2>

 <div class="workspace-toolbar">
    <a id="go-to-workspace" class="btn btn-primary" href="https://app.powerbi.com/groups/@Model.WorkspaceId.ToString()" target="WorkspaceWebUrl">
      Go to workspace
    </a>
    <a id="embed-report" class="btn btn-primary" asp-action="Embed" asp-route-TenantName="@Model.Name" target="_blank" rel="noopener noreferrer" >
      Embed
    </a>
</div>

<form class="form-horizontal" role="form">

  <fieldset>
    <legend>General Information</legend>
    <div class="form-group row">
      <label for="Name" class="col-sm-2 col-form-label">Name</label>
      <div class="col-sm-10">
        <input class="form-control " id="Name" name="Name" readonly value="@Model.Name">
      </div>
      <label for="Created" class="col-sm-2 col-form-label">Created</label>
      <div class="col-sm-10">
        <input class="form-control " id="Created" name="Created" readonly value="@Model.Created.ToString("g")">
      </div>
    </div>
  </fieldset>
  
  <fieldset>
    <legend>Tenant Application Identity</legend>
    <div class="form-group row">
      <label for="ApplicationDisplayName" class="col-sm-2 col-form-label">Application Display Name</label>
      <div class="col-sm-10">
        <input class="form-control" id="ApplicationDisplayName" name="ApplicationDisplayName" readonly="readonly" value="@Model.ApplicationDisplayName">
      </div>
    </div>
    <div class="form-group row">
      <label for="ApplicationObjectId" class="col-sm-2 col-form-label">Application Object Id</label>
      <div class="col-sm-10">
        <input class="form-control" id="ApplicationObjectId" name="ApplicationObjectId" readonly="readonly" value="@Model.ApplicationObjectId">
      </div>
    </div>
    <div class="form-group row">
      <label for="ClientId" class="col-sm-2 col-form-label">Client Id</label>
      <div class="col-sm-10">
        <input class="form-control" id="ClientId" name="ClientId" readonly="readonly" value="@Model.ClientId">
      </div>
    </div>
    <div class="form-group row">
      <label for="ServicePrincipalId" class="col-sm-2 col-form-label">Service Principal Id</label>
      <div class="col-sm-10">
        <input class="form-control" id="ServicePrincipalId" name="ServicePrincipalId" readonly="readonly" value="@Model.ServicePrincipalId">
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Workspace Details</legend>
    <div class="form-group row">
      <label for="WorkspaceDisplayName" class="col-sm-2 col-form-label">Display Name</label>
      <div class="col-sm-10">
        <input class="form-control" id="WorkspaceDisplayName" name="WorkspaceDisplayName" readonly="readonly" value="@Model.WorkspaceDisplayName">
      </div>
    </div>
    <div class="form-group row">
      <label for="WorkspaceId" class="col-sm-2 col-form-label">Workspace Id</label>
      <div class="col-sm-10">
        <input class="form-control" id="WorkspaceId" name="WorkspaceId" readonly="readonly" value="@Model.WorkspaceId">
      </div>
    </div>
   </fieldset>

  <fieldset>
    <legend>Solution Details</legend>
    <div class="form-group row">
      <label for="SolutionName" class="col-sm-2 col-form-label">Solution Name</label>
      <div class="col-sm-10">
        <input class="form-control" id="SolutionNameId" name="SolutionName" readonly="readonly" value="@Model.SolutionName">
      </div>
    </div>
    <div class="form-group row">
      <label for="SolutionDeployed" class="col-sm-2 col-form-label">Solution Deployed</label>
      <div class="col-sm-10">
        <input class="form-control" id="SolutionDeployed" name="SolutionDeployed" readonly="readonly" value="@Model.SolutionDeployed">
      </div>
    </div>
    <div class="form-group row">
      <label for="DataFileUrl" class="col-sm-2 col-form-label">Data File Url</label>
      <div class="col-sm-10">
        <input class="form-control" id="DataFileUrl" name="DataFileUrl" readonly="readonly" value="@Model.DataFileUrl">
      </div>
    </div>

  </fieldset>

</form>
