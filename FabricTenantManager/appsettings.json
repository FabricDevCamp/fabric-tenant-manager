{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "mytenant.onmicrosoft.com",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "ClientSecret": "[MY_SECRET_FOR_CLIENT_AUTH_ONLY]",
    "CallbackPath": "/signin-oidc"
  },
  "ManagedIdentity": {
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "PrincipalId": "00000000-0000-0000-0000-000000000000"

  },
  "FabricTenantManagerDb": {
    "ConnectString": "Server=tcp:myserver.database.windows.net,1433;Initial Catalog=FabricTenantManagerDb;"
  },
  "Fabric": {
    "FabricRestApiBaseUrl": "https://api.fabric.microsoft.com",
    "FabricCapacityId": "00000000-0000-0000-0000-000000000000",
    "AdminUserId": "00000000-0000-0000-0000-000000000000"
  },
  "AzureStorage": {
    "SasToken": "[MY_SAS_TOKEN_FOR_AZURE_STORAGE_CONTAINER]"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System": "Warning",
      "Microsoft.Identity.Web": "None",
      "Microsoft.Identity.Web.UI": "None"
    }
  },
  "AllowedHosts": "*"
